<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the daily misbar report job. Rendered by
  scripts/misbar-automation-install.sh, which substitutes:
    __HOUR__     0-23   run hour
    __MINUTE__   0-59   run minute
    __SCRIPT__          absolute path to scripts/misbar-daily.sh
    __LOG__             absolute path to ~/Library/Logs/misbar-daily.log
  Contains NO secrets — com.misbar.kamc-live keeps GRAFANA_TOKEN / DATA_KEY in
  its own plist, and launchd does NOT propagate environment between jobs.

  PATH is declared explicitly: launchd's default (/usr/bin:/bin:/usr/sbin:/sbin)
  omits /usr/local/bin, where node lives, so without it the snapshot refresh that
  misbar-daily.sh invokes cannot even start. Note that PATH alone is not enough —
  since this job carries no secrets, fetch-kamc.mjs still exits non-zero and the
  report is built from whatever snapshot com.misbar.kamc-live last pushed.

  Scheduling: com.misbar.kamc-live drives the SAME working copy at every :00 and
  :30 from 07:00-22:30. Pick an off-grid minute (e.g. 08:15) so the two jobs never
  run git in that checkout concurrently.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.misbar.daily-report</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
